# Server-only configuration. Never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYMENT_WEBHOOK_SECRET=
OWNER_BANK_CODE=BIDV
OWNER_BANK_ACCOUNT=
OWNER_BANK_NAME=

# Facebook Page publishing. Keep the Page Access Token server-side only.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional aliases supported by the publisher: META_PAGE_ACCESS_TOKEN / FACEBOOK_ACCESS_TOKEN
FACEBOOK_AUTOPUBLISH_ENABLED=false
FACEBOOK_DAILY_POST_LIMIT=5
# Optional comma-separated public RSS/Atom feeds for buyer-intent discovery.
# If empty, safe public default feeds are used.
FACEBOOK_SIGNAL_FEEDS=
META_GRAPH_API_VERSION=v24.0
