/* ─────────────── 8. CART & WISHLIST ─────────────── */
let cart = {};
let wishlist = new Set();

function loadState() {
  try {
    const c = localStorage.getItem('flowforge_cart_v3');
    if (c) cart = JSON.parse(c) || {};
    const w = localStorage.getItem('flowforge_wish_v3');
    if (w) wishlist = new Set(JSON.parse(w) || []);
  } catch (e) { cart = {}; wishlist = new Set(); }
}

function saveState() {
  try {
    localStorage.setItem('flowforge_cart_v3', JSON.stringify(cart));
    localStorage.setItem('flowforge_wish_v3', JSON.stringify([...wishlist]));
    localStorage.setItem('flowforge_lang', currentLang);
  } catch (e) { /* ignore */ }
}

function cartCount() { return Object.values(cart).reduce((a, b) => a + b, 0); }

function cartTotals() {
  let subtotalVND = 0, subtotalUSD = 0, items = 0;
  Object.entries(cart).forEach(([id, qty]) => {
    const p = PRODUCTS.find(x => x.id === id);
    if (!p || qty <= 0) return;
    subtotalVND += p.priceVND * qty;
    subtotalUSD += p.priceUSD * qty;
    items += qty;
  });
  let rate = 0;
  if (items >= 4) rate = 0.15;
  else if (items >= 2) rate = 0.10;
  return {
    items,
    subtotalVND, subtotalUSD,
    discountVND: subtotalVND * rate,
    discountUSD: subtotalUSD * rate,
    totalVND: subtotalVND - subtotalVND * rate,
    totalUSD: subtotalUSD - subtotalUSD * rate
  };
}

function addToCart(id, silent = false) {
  const p = PRODUCTS.find(x => x.id === id);
  if (!p) return;
  cart[id] = (cart[id] || 0) + 1;
  saveState();
  renderCart();
  updateCartBadge();
  if (!silent) {
    toast(`${t('added_to_cart')}: ${getProductLocale(p).name}`, 'success');
    bumpCartIcon();
  }
}

function removeFromCart(id) {
  delete cart[id];
  saveState();
  renderCart();
  updateCartBadge();
}

function setQty(id, qty) {
  if (qty <= 0) { removeFromCart(id); return; }
  cart[id] = qty;
  saveState();
  renderCart();
  updateCartBadge();
}

function toggleWishlist(id) {
  if (wishlist.has(id)) {
    wishlist.delete(id);
    toast(t('wishlist_removed'), 'info', 1600);
  } else {
    wishlist.add(id);
    toast(t('wishlist_added'), 'success', 1600);
