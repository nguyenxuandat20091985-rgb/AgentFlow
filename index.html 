/* ─────────────── 12. QR RENDERER ─────────────── */
function hashCode(str) {
  let h = 0;
  for (let i = 0; i < str.length; i++) {
    h = (h << 5) - h + str.charCodeAt(i);
    h |= 0;
  }
  return h >>> 0;
}

function mulberry32(seed) {
  let a = seed;
  return function () {
    a |= 0;
    a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function payosSeed() {
  const tot = cartTotals();
  return 'PAYOS|' + Math.round(tot.totalVND) + '|' + currentOrderCode;
}

function usdtSeed() {
  const tot = cartTotals();
  return 'USDT|' + currentNet + '|' + tot.totalUSD.toFixed(2) + '|' + WALLETS[currentNet].address;
}

function drawQR(canvas, seedStr) {
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const size = 29;
  const rand = mulberry32(hashCode(seedStr));
  const cssSize = canvas.clientWidth || 114;
  const dpr = Math.min(window.devicePixelRatio || 1, 3);

  canvas.width = Math.round(cssSize * dpr);
  canvas.height = Math.round(cssSize * dpr);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, cssSize, cssSize);

  const cell = cssSize / size;
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, cssSize, cssSize);

  const isFinder = (r, c) => {
    const inBox = (r0, c0) => r >= r0 && r < r0 + 7 && c >= c0 && c < c0 + 7;
    return inBox(0, 0) || inBox(0, size - 7) || inBox(size - 7, 0);
  };

  ctx.fillStyle = '#05060b';
  for (let r = 0; r < size; r++) {
    for (let c = 0; c < size; c++) {
      if (isFinder(r, c)) continue;
      if (rand() > 0.52) {
        ctx.fillRect(c * cell, r * cell, cell * 0.94, cell * 0.94);
      }
    }
  }

  const drawFinder = (r0, c0) => {
    ctx.fillStyle = '#05060b';
    ctx.fillRect(c0 * cell, r0 * cell, cell * 7, cell * 7);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect((c0 + 1) * cell, (r0 + 1) * cell, cell * 5, cell * 5);
    ctx.fillStyle = '#05060b';
    ctx.fillRect((c0 + 2) * cell, (r0 + 2) * cell, cell * 3, cell * 3);
  };
  drawFinder(0, 0);
  drawFinder(0, size - 7);
  drawFinder(size - 7, 0);
}

