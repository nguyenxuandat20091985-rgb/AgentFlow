  font-family:'JetBrains Mono',monospace;
  font-size:12.6px;font-weight:600;color:var(--text);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.kv-value.hl{color:#c4b5fd;}

.net-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.net-chip{
  padding:9px 13px;border-radius:11px;
  border:1px solid var(--border);background:rgba(255,255,255,.026);
  font-size:12.4px;font-weight:600;color:var(--muted);
  transition:.26s var(--ease);
  display:flex;flex-direction:column;gap:2px;
}
.net-chip small{font-size:10px;color:var(--muted-2);font-weight:500;}
.net-chip:hover{color:#fff;border-color:var(--border-2);}
.net-chip.active{
  color:#fff;border-color:rgba(52,211,153,.5);
  background:linear-gradient(150deg,rgba(52,211,153,.15),rgba(34,211,238,.07));
  box-shadow:0 10px 26px -14px rgba(52,211,153,.85);
}

.notice{
  display:flex;gap:11px;align-items:flex-start;
  padding:13px 15px;border-radius:var(--radius-xs);
  font-size:12.4px;line-height:1.62;color:var(--text-2);
  background:rgba(251,191,36,.075);
  border:1px solid rgba(251,191,36,.22);
  margin-bottom:18px;
}
.notice svg{width:15px;height:15px;flex:none;margin-top:2px;color:#fbbf24;}
.notice.info{background:rgba(99,102,241,.075);border-color:rgba(129,140,248,.22);}
.notice.info svg{color:#a5b4fc;}

.pay-success{text-align:center;padding:26px 12px 12px;display:none;}
.pay-success.show{display:block;animation:fadeUp .5s var(--ease);}
.success-ring{
  width:76px;height:76px;border-radius:50%;margin:0 auto 22px;
  display:grid;place-items:center;
  background:radial-gradient(circle,rgba(52,211,153,.22),transparent 70%);
  border:1px solid rgba(52,211,153,.4);
  box-shadow:0 0 44px -8px rgba(52,211,153,.6);
  animation:popIn .55s var(--ease);
}
@keyframes popIn{0%{transform:scale(.5);opacity:0;}60%{transform:scale(1.07);}100%{transform:scale(1);opacity:1;}}
.success-ring svg{width:34px;height:34px;color:#6ee7b7;}
.pay-success h3{font-size:19px;margin-bottom:11px;letter-spacing:-0.032em;}
.pay-success p{font-size:13.6px;color:var(--muted);line-height:1.7;max-width:380px;margin:0 auto 22px;}
.order-code{
  display:inline-block;
  font-family:'JetBrains Mono',monospace;
  font-size:13.4px;font-weight:600;color:#c4b5fd;
  padding:9px 16px;border-radius:11px;
  background:rgba(139,92,246,.12);
  border:1px dashed rgba(139,92,246,.4);
  margin-bottom:22px;
}

/* ═══════════════════════════════════════════════════════════
   13. AI CHAT WIDGET
   ═══════════════════════════════════════════════════════════ */
.chat-fab{
  position:fixed;bottom:24px;inset-inline-end:24px;z-index:88;
  width:60px;height:60px;border-radius:50%;
  display:grid;place-items:center;
  background:var(--grad-btn);color:#fff;
  box-shadow:0 16px 44px -12px rgba(124,58,237,.95), 0 0 0 1px rgba(255,255,255,.12) inset;
  transition:.34s var(--ease);
}
.chat-fab:hover{transform:translateY(-4px) scale(1.05);box-shadow:0 24px 56px -14px rgba(139,92,246,1);}
.chat-fab svg{width:26px;height:26px;}
.chat-fab .pulse-ring{
  position:absolute;inset:-4px;border-radius:50%;
  border:2px solid rgba(139,92,246,.5);
  animation:fabPulse 2.4s ease-out infinite;
  pointer-events:none;
}
@keyframes fabPulse{
  0%{transform:scale(.94);opacity:.8;}
  100%{transform:scale(1.35);opacity:0;}
}
.chat-fab .badge-dot{
  position:absolute;top:2px;inset-inline-end:2px;
  width:12px;height:12px;border-radius:50%;
  background:#34d399;box-shadow:0 0 0 3px var(--bg);
  animation:pulse 2s ease-in-out infinite;
}

.chat-panel{
  position:fixed;bottom:24px;inset-inline-end:24px;z-index:98;
  width:min(400px, calc(100vw - 32px));
  height:min(600px, calc(100vh - 48px));
  border-radius:22px;
  display:flex;flex-direction:column;
  background:linear-gradient(170deg,rgba(14,16,26,.985),rgba(6,7,12,.995));
  border:1px solid var(--border-2);
  box-shadow:0 50px 100px -30px rgba(0,0,0,1), 0 0 0 1px rgba(139,92,246,.15);
  backdrop-filter:blur(24px);
  transform:translateY(20px) scale(.96);
  opacity:0;pointer-events:none;
  transition:.42s var(--ease);
  overflow:hidden;
}
.chat-panel.open{transform:none;opacity:1;pointer-events:auto;}
.chat-panel::before{
  content:"";position:absolute;top:0;left:10%;right:10%;height:1px;
  background:linear-gradient(90deg,transparent,rgba(196,181,253,.85),transparent);
  z-index:2;
}

.chat-head{
  display:flex;align-items:center;gap:11px;
  padding:15px 17px;border-bottom:1px solid var(--border);
  flex:none;background:rgba(255,255,255,.018);
}
.chat-avatar{
  width:36px;height:36px;border-radius:11px;flex:none;
  display:grid;place-items:center;
  background:var(--grad-btn);color:#fff;
  box-shadow:0 8px 20px -8px rgba(124,58,237,.95), inset 0 1px 0 rgba(255,255,255,.3);
  position:relative;
}
.chat-avatar svg{width:18px;height:18px;}
.chat-avatar .online{
  position:absolute;bottom:-2px;inset-inline-end:-2px;
  width:11px;height:11px;border-radius:50%;
  background:#34d399;box-shadow:0 0 0 2px #0e101a;
}
.chat-head-info{flex:1;min-width:0;}
.chat-head-info strong{display:block;font-size:14px;font-weight:700;letter-spacing:-0.025em;}
.chat-head-info small{
  display:flex;align-items:center;gap:5px;
  font-size:11.5px;color:#6ee7b7;font-weight:500;
}
.chat-head-info small i{
  width:5px;height:5px;border-radius:50%;background:#34d399;
  box-shadow:0 0 6px 1px rgba(52,211,153,.85);flex:none;
}
.chat-head .icon-btn{width:34px;height:34px;border-radius:10px;}
.chat-head .icon-btn svg{width:16px;height:16px;}

.chat-body{
  flex:1;overflow-y:auto;
  padding:18px 16px;
  display:flex;flex-direction:column;gap:12px;
  scroll-behavior:smooth;
}
.chat-msg{
  display:flex;gap:9px;align-items:flex-end;
  max-width:88%;
  animation:msgIn .35s var(--ease);
}
@keyframes msgIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}
.chat-msg.user{margin-inline-start:auto;flex-direction:row-reverse;}
.msg-bubble{
  padding:11px 14px;border-radius:16px;
  font-size:13.6px;line-height:1.6;
  word-wrap:break-word;overflow-wrap:break-word;
}
.chat-msg.bot .msg-bubble{
  background:rgba(255,255,255,.055);
  border:1px solid var(--border);
  border-end-start-radius:5px;
  color:var(--text-2);
}
.chat-msg.user .msg-bubble{
  background:var(--grad-btn);color:#fff;
  border-end-end-radius:5px;
  box-shadow:0 8px 22px -10px rgba(124,58,237,.95);
}
.msg-avatar{
  width:26px;height:26px;border-radius:8px;flex:none;
  display:grid;place-items:center;font-size:10px;font-weight:700;
}
.chat-msg.bot .msg-avatar{background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff;}
.chat-msg.bot .msg-avatar svg{width:13px;height:13px;}

.typing{display:flex;gap:4px;align-items:center;padding:11px 14px;}
.typing i{
  width:6px;height:6px;border-radius:50%;background:var(--muted);
  animation:typing 1.4s infinite ease-in-out;
}
.typing i:nth-child(2){animation-delay:.2s;}
.typing i:nth-child(3){animation-delay:.4s;}
@keyframes typing{0%,60%,100%{transform:translateY(0);opacity:.4;}30%{transform:translateY(-5px);opacity:1;}}

.chat-suggestions{
  display:flex;gap:7px;flex-wrap:wrap;
  padding:0 16px 12px;
}
.suggest-chip{
  padding:7px 12px;border-radius:99px;
  border:1px solid var(--border);background:var(--surface);
  font-size:11.8px;font-weight:500;color:var(--muted);
  transition:.24s var(--ease);
  white-space:nowrap;
}
.suggest-chip:hover{color:#fff;border-color:rgba(139,92,246,.5);background:rgba(139,92,246,.12);}

.chat-foot{
  flex:none;padding:12px 16px 14px;
  border-top:1px solid var(--border);
  background:rgba(255,255,255,.018);
  display:flex;gap:8px;align-items:flex-end;
}
.chat-input{
  flex:1;min-width:0;
  padding:11px 14px;border-radius:14px;
  border:1px solid var(--border);background:var(--surface);
  font-size:13.6px;color:var(--text);
  transition:.28s var(--ease);
  resize:none;
  max-height:100px;min-height:42px;
  font-family:inherit;
  line-height:1.5;
}
.chat-input::placeholder{color:var(--muted-2);}
.chat-input:focus{
  outline:none;border-color:rgba(139,92,246,.5);
  background:var(--surface-2);
  box-shadow:0 0 0 3px rgba(139,92,246,.1);
}
.chat-send{
  width:42px;height:42px;border-radius:12px;flex:none;
  display:grid;place-items:center;
  background:var(--grad-btn);color:#fff;
  transition:.28s var(--ease);
  box-shadow:0 8px 22px -10px rgba(124,58,237,.95);
}
.chat-send:hover{transform:translateY(-2px);box-shadow:0 12px 28px -10px rgba(139,92,246,1);}
.chat-send:disabled{opacity:.4;cursor:not-allowed;transform:none;}
.chat-send svg{width:17px;height:17px;}

/* ═══════════════════════════════════════════════════════════
   14. TOAST
   ═══════════════════════════════════════════════════════════ */
.toast-wrap{
  position:fixed;bottom:96px;inset-inline-end:24px;z-index:120;
  display:flex;flex-direction:column;gap:10px;
  pointer-events:none;
  max-width:calc(100vw - 32px);
}
.toast{
  display:flex;align-items:center;gap:12px;
  padding:13px 17px;border-radius:14px;
  background:linear-gradient(150deg,rgba(20,23,36,.97),rgba(10,11,18,.99));
  border:1px solid var(--border-2);
  box-shadow:0 24px 50px -20px rgba(0,0,0,1);
  backdrop-filter:blur(18px);
  font-size:13.4px;font-weight:600;color:var(--text);
  transform:translateX(120%);opacity:0;
  transition:.45s var(--ease);
  pointer-events:auto;max-width:340px;
}
html[dir="rtl"] .toast{transform:translateX(-120%);}
.toast.show{transform:none;opacity:1;}
.toast-icon{
  width:26px;height:26px;border-radius:8px;flex:none;
  display:grid;place-items:center;
}
.toast-icon svg{width:14px;height:14px;}
.toast.success .toast-icon{background:rgba(52,211,153,.15);color:#6ee7b7;border:1px solid rgba(52,211,153,.32);}
.toast.info .toast-icon{background:rgba(99,102,241,.15);color:#a5b4fc;border:1px solid rgba(129,140,248,.32);}
.toast.warn .toast-icon{background:rgba(251,191,36,.15);color:#fbbf24;border:1px solid rgba(251,191,36,.32);}

/* ═══════════════════════════════════════════════════════════
   15. SCROLL REVEAL
   ═══════════════════════════════════════════════════════════ */
.reveal{
  opacity:0;transform:translateY(24px);
  transition:opacity .8s var(--ease), transform .8s var(--ease);
  transition-delay:var(--d,0ms);
}
.reveal.in{opacity:1;transform:none;}

@keyframes fadeUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}

/* ═══════════════════════════════════════════════════════════
   16. RESPONSIVE
   ═══════════════════════════════════════════════════════════ */
@media (max-width:1080px){
  .hero-grid{grid-template-columns:1fr;gap:60px;}
  .hero-visual{max-width:640px;margin:0 auto;width:100%;}
  .float-1{inset-inline-end:0;}
  .float-2{inset-inline-start:0;}
}
