<script>
(async function loadAgentFlowPaymentConfig(){
  try {
    const r = await fetch('/api/payments/config', { cache: 'no-store' });
    if (!r.ok) return;
    const c = await r.json();
    const bank = c.bank || {};
    const crypto = c.crypto || {};
    const bankName = document.getElementById('paymentBankName');
    const holder = document.getElementById('paymentBankHolder');
    const account = document.getElementById('paymentBankAccount');
    if (bankName) bankName.textContent = (bank.name || 'BIDV') + (bank.branch ? ' — ' + bank.branch : '');
    if (holder) holder.textContent = bank.accountName || 'NGUYỄN XUÂN ĐẠT';
    if (account) account.textContent = bank.accountNo || '4430269669';
    const wallet = crypto.address || '';
    const walletEl = document.getElementById('kvWallet');
    const copyWallet = document.getElementById('copyWallet');
    if (walletEl) walletEl.textContent = wallet;
    if (copyWallet) copyWallet.dataset.copyValue = wallet;
    const qr = document.getElementById('qrUsdtImage');
    if (qr && wallet) qr.src = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=' + encodeURIComponent(wallet);
  } catch (e) {
    console.warn('[AgentFlow] payment config unavailable', e);
  }
})();
</script>

