/* Primary AI — intent matcher.
   Returns { intent } or null if no confident match. */
function primaryIntent(msg) {
  const m = msg.toLowerCase();
  const has = (...arr) => arr.some(w => m.includes(w));

  // Greeting
  if (/^(hi|hello|hey|xin chào|chào|hola|bonjour|hallo|привет|مرحبا|你好|こんにちは|안녕하세요)\b/.test(m)) return 'greeting';

  // Thanks
  if (has('thank', 'thanks', 'cảm ơn', 'cam on', 'gracias', 'merci', 'danke', 'спасибо', 'شكرا', 'ありがと', '감사', '谢谢')) return 'thanks';

  // Payment — USDT
  if (has('usdt', 'crypto', 'wallet', 'trc20', 'bep20', 'erc20', 'tether', 'ví ', 'tether')) return 'payment_usdt';

  // Payment — payOS / bank
  if (has('payos', 'bank', 'transfer', 'chuyển khoản', 'ngân hàng', 'banking', 'بانك')) return 'payment_payos';

  // Delivery
  if (has('receive', 'delivery', 'download', 'nhận file', 'tải', 'giao hàng', '交付', '受け取り', '받는', 'entrega', 'livraison', 'lieferung', 'доставк')) return 'delivery';

  // Refund
  if (has('refund', 'return', 'hoàn tiền', 'trả lại', '退款', '返金', '환불', 'reembolso', 'remboursement', 'erstattung', 'возврат', 'استرداد')) return 'refund';

  // Lead gen
  if (has('lead', 'leads', 'leadgen', 'lead gen', 'potential customer', 'khách hàng tiềm năng', 'tìm khách', '潜客', 'リード', '리드', 'clientes potenciales', 'prospect', 'лид')) return 'leadgen';

  // Support
  if (has('support agent', 'customer service', 'cskh', 'chăm sóc khách', '客服', 'サポート', '지원', 'soporte', 'support client', 'kundenservice', 'поддержк', 'دعم')) return 'support';

  // Bestsellers
  if (has('best', 'popular', 'top', 'bán chạy', 'phổ biến', '最畅销', '人気', '인기', 'más vendido', 'meilleur', 'bestseller', 'популярн', 'الأكثر')) return 'bestseller';

  // Pricing
  if (has('price', 'cost', 'how much', 'giá', 'bao nhiêu', '价格', '価格', '가격', 'precio', 'prix', 'preis', 'цена', 'سعر')) return 'pricing';

  // Technical
  if (has('how to', 'import', 'install', 'setup', 'technical', 'kỹ thuật', 'cài đặt', 'tích hợp', '技术', '設定', '설치', 'técnico', 'technique', 'technisch', 'техническ', 'تقني')) return 'technical';

  // Help
  if (has('help', 'what can you', 'giúp', 'hỗ trợ', '帮助', 'ヘルプ', '도움', 'ayuda', 'aide', 'hilfe', 'помощь', 'مساعدة')) return 'help';

  // Any product name hint → pricing-style answer
  for (const p of PRODUCTS) {
    const loc = PRODUCT_I18N.en[p.id];
    if (loc && m.includes(loc.name.toLowerCase().slice(0, 12))) return 'pricing';
  }

  return null;
}

/* Compose answer with intent bank */
function composeAnswer(intent, lang) {
  const bank = CHAT_BANK[intent];
  if (!bank) return null;
  return bank[lang] || bank.en;
}

/* Main AI responder.
   Tries primary → falls back to secondary → falls back to generic.
   Returns a Promise so we can add a small "thinking" delay. */
function aiRespond(message) {
  return new Promise(resolve => {
    const lang = detectLanguage(message) || currentLang;
    let reply = null;
    let source = 'primary';

    try {
      const intent = primaryIntent(message);
      if (intent) {
        reply = composeAnswer(intent, lang);
      }
    } catch (e) {
      console.warn('[AI primary error]', e);
    }

    /* Fallback AI — simpler heuristic: check keywords across all langs */
    if (!reply) {
      source = 'fallback';
      try {
        const m = message.toLowerCase();
        if (m.includes('usdt') || m.includes('crypto') || m.includes('ví')) {
          reply = CHAT_BANK.payment_usdt[lang] || CHAT_BANK.payment_usdt.en;
        } else if (m.includes('payos') || m.includes('bank') || m.includes('ngân hàng')) {
          reply = CHAT_BANK.payment_payos[lang] || CHAT_BANK.payment_payos.en;
        } else if (m.length > 4) {
          reply = CHAT_FALLBACK[lang] || CHAT_FALLBACK.en;
        } else {
          reply = CHAT_BANK.help[lang] || CHAT_BANK.help.en;
        }
      } catch (e) {
        console.warn('[AI fallback error]', e);
        reply = CHAT_FALLBACK[currentLang] || CHAT_FALLBACK.en;
        source = 'emergency';
      }
    }

    if (!reply) {
      reply = CHAT_FALLBACK.en;
      source = 'emergency';
    }

    /* Simulate network latency for a natural feel */
    const delay = 420 + Math.random() * 520;
    setTimeout(() => resolve({ reply, source, lang }), delay);
  });
}

/* ─────────────── 6. LANGUAGE MANAGER ─────────────── */
function applyLanguage(lang) {
  if (!T[lang]) lang = 'en';
  currentLang = lang;

  const meta = LANGUAGES.find(l => l.code === lang) || LANGUAGES[1];
  document.documentElement.lang = lang;
  document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';

  $('#currentFlag').textContent = meta.flag;
  $('#currentLang').textContent = meta.short;

  /* UI strings */
  $$('[data-i18n]').forEach(el => {
    const key = el.dataset.i18n;
    el.textContent = t(key);
  });
  /* HTML content (safe: our own translation strings) */
  $$('[data-i18n-html]').forEach(el => {
    const key = el.dataset.i18nHtml;
    el.innerHTML = t(key);
  });
  /* Placeholders */
  $$('[data-i18n-placeholder]').forEach(el => {
    el.setAttribute('placeholder', t(el.dataset.i18nPlaceholder));
  });

  /* Re-render dynamic sections */
  renderProducts();
  renderCart();
  renderSuggestions();
  updateChatWelcome();

  saveState();

  /* Update lang menu active state */
  $$('#langMenu button').forEach(b => {
    b.classList.toggle('active', b.dataset.code === lang);
  });
}

function buildLangMenu() {
  const menu = $('#langMenu');
  menu.innerHTML = LANGUAGES.map(l => `
    <button data-code="${l.code}" role="menuitem">
      <span class="flag">${l.flag}</span>
      <span>${l.label}</span>
    </button>
  `).join('');

  menu.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-code]');
    if (!btn) return;
    applyLanguage(btn.dataset.code);
    menu.classList.remove('open');
  });
}

function detectBrowserLanguage() {
  const saved = localStorage.getItem('flowforge_lang');
  if (saved && T[saved]) return saved;

  const nav = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
  const two = nav.split('-')[0];
  if (T[two]) return two;
  return 'en';
}

