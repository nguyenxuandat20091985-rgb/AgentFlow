<style>
/* ═══════════════════════════════════════════════════════════
   0. DESIGN TOKENS
   ═══════════════════════════════════════════════════════════ */
:root{
  --bg:#05060b;
  --surface:rgba(255,255,255,.035);
  --surface-2:rgba(255,255,255,.06);
  --surface-3:rgba(255,255,255,.09);
  --border:rgba(255,255,255,.09);
  --border-2:rgba(255,255,255,.18);

  --text:#eef1f8;
  --text-2:#b6bdcd;
  --muted:#858da3;
  --muted-2:#5f6779;

  --brand-1:#6366f1;
  --brand-2:#a855f7;
  --brand-3:#22d3ee;
  --success:#34d399;
  --warn:#fbbf24;
  --danger:#f87171;

  --grad:linear-gradient(100deg,#818cf8 0%,#c084fc 45%,#67e8f9 100%);
  --grad-btn:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%);

  --radius:20px;
  --radius-sm:13px;
  --radius-xs:9px;
  --maxw:1280px;

  --shadow-sm:0 2px 10px rgba(0,0,0,.35);
  --shadow-md:0 18px 40px -18px rgba(0,0,0,.85);
  --shadow-lg:0 40px 90px -40px rgba(0,0,0,.95);
  --glow:0 0 0 1px rgba(139,92,246,.28), 0 12px 44px -12px rgba(139,92,246,.5);

  --ease:cubic-bezier(.16,1,.3,1);
  --header-h:70px;
}

/* ═══════════════════════════════════════════════════════════
   1. RESET & BASE
   ═══════════════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;}
html{
  scroll-behavior:smooth;
  -webkit-text-size-adjust:100%;
  scroll-padding-top:96px;
}
body{
  margin:0;
  font-family:'Inter','Noto Sans SC','Noto Sans JP','Noto Sans KR','Noto Sans Arabic',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
  font-size:16px;
  letter-spacing:-0.005em;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  min-height:100vh;
}
body.locked{overflow:hidden;}
img,svg,canvas{display:block;max-width:100%;}
button,input,select,textarea{font:inherit;color:inherit;}
button{cursor:pointer;border:0;background:none;}
a{color:inherit;text-decoration:none;}
ul{margin:0;padding:0;list-style:none;}
h1,h2,h3,h4,h5{margin:0;font-weight:700;letter-spacing:-0.03em;line-height:1.15;}
p{margin:0;}
code,pre{font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;}
::selection{background:rgba(139,92,246,.4);color:#fff;}

::-webkit-scrollbar{width:10px;height:10px;}
::-webkit-scrollbar-track{background:#07080e;}
::-webkit-scrollbar-thumb{
  background:linear-gradient(180deg,#312e81,#5b21b6);
  border-radius:99px;border:2px solid #07080e;
}
::-webkit-scrollbar-thumb:hover{background:linear-gradient(180deg,#4338ca,#7c3aed);}

/* RTL support */
html[dir="rtl"] body{letter-spacing:0;}
html[dir="rtl"] .nav-links a,
html[dir="rtl"] .footer-col a{transform:none;}
html[dir="rtl"] .footer-col a:hover{transform:translateX(-3px);}

/* ═══════════════════════════════════════════════════════════
   2. AMBIENT BACKGROUND
   ═══════════════════════════════════════════════════════════ */
.bg-layer{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
.bg-layer::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(900px 520px at 10% -8%, rgba(99,102,241,.26), transparent 62%),
    radial-gradient(820px 520px at 92% -4%, rgba(168,85,247,.20), transparent 62%),
    radial-gradient(900px 700px at 50% 112%, rgba(34,211,238,.11), transparent 64%),
    radial-gradient(600px 400px at 78% 62%, rgba(139,92,246,.09), transparent 65%);
}
.bg-grid{
  position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size:64px 64px;
  mask-image:radial-gradient(ellipse 100% 65% at 50% 0%, #000 5%, transparent 78%);
  -webkit-mask-image:radial-gradient(ellipse 100% 65% at 50% 0%, #000 5%, transparent 78%);
}
.orb{position:absolute;border-radius:50%;filter:blur(90px);opacity:.5;animation:float 22s ease-in-out infinite;}
.orb.a{width:420px;height:420px;background:radial-gradient(circle,#4f46e5,transparent 68%);top:-140px;left:-120px;}
.orb.b{width:380px;height:380px;background:radial-gradient(circle,#a855f7,transparent 68%);top:34%;right:-160px;animation-delay:-7s;}
.orb.c{width:460px;height:460px;background:radial-gradient(circle,#0891b2,transparent 70%);bottom:-200px;left:28%;animation-delay:-13s;}
@keyframes float{
  0%,100%{transform:translate3d(0,0,0) scale(1);}
  33%{transform:translate3d(40px,-30px,0) scale(1.08);}
  66%{transform:translate3d(-30px,26px,0) scale(.95);}
}

/* ═══════════════════════════════════════════════════════════
   3. LAYOUT UTILITIES
   ═══════════════════════════════════════════════════════════ */
.page{position:relative;z-index:1;}
.container{width:100%;max-width:var(--maxw);margin:0 auto;padding:0 22px;}
section{position:relative;scroll-margin-top:96px;}
.section{padding:96px 0;}
.section-sm{padding:64px 0;}

.glass{
  background:linear-gradient(160deg, rgba(255,255,255,.07), rgba(255,255,255,.022));
  border:1px solid var(--border);
  backdrop-filter:blur(22px) saturate(160%);
  -webkit-backdrop-filter:blur(22px) saturate(160%);
  box-shadow:var(--shadow-md), inset 0 1px 0 rgba(255,255,255,.075);
}

.grad-text{
  background:var(--grad);
  -webkit-background-clip:text;background-clip:text;
  color:transparent;-webkit-text-fill-color:transparent;
}

.eyebrow{
  display:inline-flex;align-items:center;gap:9px;
  font-size:12.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:#a5b4fc;
  padding:7px 15px;border-radius:99px;
  background:rgba(99,102,241,.09);
  border:1px solid rgba(129,140,248,.24);
  backdrop-filter:blur(10px);
}
.eyebrow .dot{
  width:6px;height:6px;border-radius:50%;background:#818cf8;
  box-shadow:0 0 10px 2px rgba(129,140,248,.85);
  animation:pulse 2.2s ease-in-out infinite;flex:none;
}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.45;transform:scale(.78);}}

.section-head{max-width:720px;margin:0 auto 52px;text-align:center;}
.section-head h2{font-size:clamp(1.85rem,4vw,2.85rem);margin:20px 0 16px;}
.section-head p{color:var(--muted);font-size:clamp(.95rem,1.6vw,1.06rem);}

/* ═══════════════════════════════════════════════════════════
   4. BUTTONS
   ═══════════════════════════════════════════════════════════ */
.btn{
  position:relative;
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  padding:12px 20px;border-radius:var(--radius-sm);
  font-size:14.5px;font-weight:600;letter-spacing:-0.01em;
  white-space:nowrap;
  transition:transform .28s var(--ease), box-shadow .28s var(--ease), background .28s ease, border-color .28s ease, opacity .2s;
  will-change:transform;
  border:1px solid transparent;
  user-select:none;
}
.btn:active{transform:scale(.97);}
.btn svg{width:17px;height:17px;flex:none;}
.btn-primary{
  background:var(--grad-btn);color:#fff;
  box-shadow:0 10px 30px -10px rgba(124,58,237,.85), inset 0 1px 0 rgba(255,255,255,.24);
}
.btn-primary::after{
  content:"";position:absolute;inset:0;border-radius:inherit;
  background:linear-gradient(180deg,rgba(255,255,255,.22),transparent 55%);
  opacity:.7;pointer-events:none;
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 42px -12px rgba(139,92,246,1), inset 0 1px 0 rgba(255,255,255,.3);}
.btn-glass{background:var(--surface-2);border-color:var(--border-2);color:var(--text);backdrop-filter:blur(14px);}
.btn-glass:hover{background:var(--surface-3);border-color:rgba(255,255,255,.28);transform:translateY(-2px);}
.btn-outline{border-color:var(--border-2);background:rgba(255,255,255,.02);color:var(--text);}
.btn-outline:hover{background:var(--surface-2);border-color:rgba(255,255,255,.3);}
.btn-lg{padding:15px 27px;font-size:15.5px;border-radius:14px;}
.btn-sm{padding:9px 15px;font-size:13.5px;border-radius:11px;}
.btn-block{width:100%;}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none!important;}

.icon-btn{
  display:inline-flex;align-items:center;justify-content:center;
  width:40px;height:40px;border-radius:11px;
  border:1px solid var(--border);background:var(--surface);color:var(--text-2);
  transition:.25s var(--ease);flex:none;position:relative;
}
.icon-btn:hover{background:var(--surface-3);color:#fff;border-color:var(--border-2);}
.icon-btn svg{width:19px;height:19px;}

/* ═══════════════════════════════════════════════════════════
   5. NAVBAR
   ═══════════════════════════════════════════════════════════ */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:80;
  transition:background .35s ease, border-color .35s ease, backdrop-filter .35s ease, box-shadow .35s ease;
  border-bottom:1px solid transparent;
}
.nav.scrolled{
  background:rgba(6,7,13,.72);
  backdrop-filter:blur(22px) saturate(170%);
  -webkit-backdrop-filter:blur(22px) saturate(170%);
  border-bottom-color:var(--border);
  box-shadow:0 12px 40px -24px rgba(0,0,0,.95);
}
.nav-inner{display:flex;align-items:center;gap:14px;height:var(--header-h);}
.brand{display:flex;align-items:center;gap:11px;flex:none;}
.brand-mark{
  width:36px;height:36px;border-radius:11px;
  background:var(--grad-btn);display:grid;place-items:center;
  box-shadow:0 8px 24px -8px rgba(124,58,237,.95), inset 0 1px 0 rgba(255,255,255,.35);
  flex:none;
}
.brand-mark svg{width:19px;height:19px;color:#fff;}
.brand-text{font-size:17px;font-weight:700;letter-spacing:-0.035em;white-space:nowrap;}
.brand-text span{color:var(--muted-2);font-weight:500;}

.nav-links{display:flex;align-items:center;gap:3px;margin-inline-start:18px;flex:1;min-width:0;}
.nav-links a{
  padding:8px 13px;border-radius:10px;
  font-size:14px;font-weight:500;color:var(--muted);
  transition:.22s ease;white-space:nowrap;
}
.nav-links a:hover{color:#fff;background:var(--surface);}

.nav-actions{display:flex;align-items:center;gap:8px;margin-inline-start:auto;flex:none;}

.lang-switch{
  position:relative;
  display:inline-flex;align-items:center;gap:7px;
  padding:8px 11px;border-radius:11px;
  border:1px solid var(--border);background:var(--surface);
  font-size:13px;font-weight:600;color:var(--text-2);
  transition:.25s var(--ease);
}
.lang-switch:hover{background:var(--surface-3);color:#fff;border-color:var(--border-2);}
.lang-switch svg{width:15px;height:15px;}
.lang-switch .current-flag{font-size:15px;line-height:1;}

.cart-btn{
  position:relative;
  display:inline-flex;align-items:center;gap:9px;
  padding:9px 15px;border-radius:11px;
  border:1px solid var(--border);background:var(--surface);
  font-size:14px;font-weight:600;color:var(--text-2);
  transition:.25s var(--ease);
}
.cart-btn:hover{background:var(--surface-3);color:#fff;border-color:var(--border-2);}
.cart-btn svg{width:18px;height:18px;}
.cart-count{
  display:none;min-width:20px;height:20px;padding:0 6px;
  border-radius:99px;background:var(--grad-btn);color:#fff;
  font-size:11px;font-weight:700;align-items:center;justify-content:center;
  box-shadow:0 0 0 3px rgba(99,102,241,.16);
}
.cart-count.show{display:inline-flex;}

.wishlist-count{
  position:absolute;top:-5px;inset-inline-end:-5px;
  min-width:17px;height:17px;padding:0 4px;
  border-radius:99px;background:linear-gradient(135deg,#f472b6,#ec4899);
  font-size:10px;font-weight:700;color:#fff;
  display:none;align-items:center;justify-content:center;
  box-shadow:0 0 0 2px var(--bg);
}
.wishlist-count.show{display:inline-flex;}

.hamburger{display:none;}

/* Language dropdown */
.lang-menu{
  position:absolute;top:calc(100% + 8px);inset-inline-end:0;
  width:230px;max-height:380px;overflow-y:auto;
  border-radius:16px;
  background:linear-gradient(165deg,rgba(18,20,32,.98),rgba(9,10,17,.99));
  border:1px solid var(--border-2);
  box-shadow:0 40px 80px -30px rgba(0,0,0,1);
  backdrop-filter:blur(20px);
  padding:8px;
  opacity:0;pointer-events:none;
  transform:translateY(-8px);
  transition:.3s var(--ease);
  z-index:90;
}
.lang-menu.open{opacity:1;pointer-events:auto;transform:none;}
.lang-menu button{
  width:100%;display:flex;align-items:center;gap:11px;
  padding:10px 12px;border-radius:10px;
  font-size:13.5px;font-weight:500;color:var(--text-2);
  transition:.2s;text-align:start;
}
.lang-menu button:hover{background:var(--surface-2);color:#fff;}
.lang-menu button.active{background:rgba(99,102,241,.15);color:#fff;font-weight:600;}
.lang-menu .flag{font-size:17px;line-height:1;flex:none;}

/* Mobile menu */
.mobile-menu{
  position:fixed;top:var(--header-h);left:0;right:0;z-index:79;
  padding:0 16px;transform:translateY(-14px);
  opacity:0;pointer-events:none;transition:.32s var(--ease);
}
.mobile-menu.open{transform:none;opacity:1;pointer-events:auto;}
.mobile-menu-inner{
  border-radius:var(--radius);padding:12px;
  display:flex;flex-direction:column;gap:3px;
  max-height:calc(100vh - 90px);overflow-y:auto;
}
.mobile-menu-inner a{
  padding:13px 15px;border-radius:12px;
  font-size:15px;font-weight:500;color:var(--text-2);
  transition:.2s;
}
.mobile-menu-inner a:hover{background:var(--surface-2);color:#fff;}
.mobile-menu-inner .btn{margin-top:8px;}

/* ═══════════════════════════════════════════════════════════
   6. HERO
   ═══════════════════════════════════════════════════════════ */
.hero{padding:140px 0 72px;position:relative;}
.hero-grid{
  display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);
  gap:56px;align-items:center;
}
.hero h1{
  font-size:clamp(2.2rem,5vw,3.9rem);
  line-height:1.06;letter-spacing:-0.042em;
  margin:24px 0 22px;font-weight:800;
}
.hero .lead{
  font-size:clamp(.98rem,1.85vw,1.12rem);
  color:var(--text-2);max-width:560px;line-height:1.72;
}
.hero-cta{display:flex;flex-wrap:wrap;gap:13px;margin:32px 0 0;}

.hero-stats{
  display:flex;flex-wrap:wrap;gap:34px;
  margin-top:44px;padding-top:28px;border-top:1px solid var(--border);
}
.stat-value{
  font-size:clamp(1.35rem,2.5vw,1.75rem);
  font-weight:800;letter-spacing:-0.04em;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;
}
.stat-label{font-size:12.5px;color:var(--muted-2);font-weight:500;letter-spacing:.02em;}

.hero-visual{position:relative;min-width:0;}
.code-card{border-radius:var(--radius);overflow:hidden;position:relative;}
.code-card::before{
  content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(150deg,rgba(139,92,246,.6),rgba(34,211,238,.25) 45%,transparent 72%);
  -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  pointer-events:none;
}
.code-head{
  display:flex;align-items:center;gap:10px;
  padding:13px 15px;border-bottom:1px solid var(--border);
  background:rgba(255,255,255,.022);
}
.dots{display:flex;gap:6px;flex:none;}
.dots i{width:10px;height:10px;border-radius:50%;display:block;}
.dots i:nth-child(1){background:#ff5f57;}
.dots i:nth-child(2){background:#febc2e;}
.dots i:nth-child(3){background:#28c840;}
.code-file{
  font-family:'JetBrains Mono',monospace;
  font-size:12px;color:var(--muted);margin-inline-start:6px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0;
}
.code-body{padding:0;}
pre.code{
  margin:0;padding:18px 18px 20px;
  font-size:12.4px;line-height:1.78;color:#c9d1e4;
  overflow-x:auto;-webkit-overflow-scrolling:touch;tab-size:2;
}
pre.code::-webkit-scrollbar{height:7px;}
pre.code::-webkit-scrollbar-thumb{background:#312e81;border-radius:99px;border:0;}
pre.code code{font-family:inherit;white-space:pre;}

.tk-str{color:#7dd3fc;}
.tk-kw{color:#c084fc;}
.tk-num{color:#fbbf24;}
.tk-com{color:#5f6779;font-style:italic;}

.copy-btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:6px 11px;border-radius:9px;
  border:1px solid var(--border);background:var(--surface);
  font-size:12px;font-weight:600;color:var(--muted);
  transition:.24s var(--ease);flex:none;
  font-family:'Inter',sans-serif;
}
.copy-btn svg{width:13px;height:13px;flex:none;transition:.24s;}
.copy-btn:hover{background:var(--surface-3);color:#fff;border-color:var(--border-2);}
.copy-btn.copied{
  color:#6ee7b7;border-color:rgba(52,211,153,.45);
  background:rgba(52,211,153,.11);
  box-shadow:0 0 0 3px rgba(52,211,153,.09);
}
.copy-btn.copied svg{transform:scale(1.15);}

.float-card{
  position:absolute;display:flex;align-items:center;gap:11px;
  padding:12px 15px;border-radius:14px;
  font-size:13px;font-weight:600;
  animation:floaty 6s ease-in-out infinite;z-index:2;
}
.float-card small{display:block;font-size:11px;font-weight:500;color:var(--muted);letter-spacing:0;}
.float-1{top:-22px;inset-inline-end:-14px;animation-delay:-1s;}
.float-2{bottom:-24px;inset-inline-start:-18px;animation-delay:-3.4s;}
.float-icon{
  width:32px;height:32px;border-radius:10px;display:grid;place-items:center;flex:none;
  background:rgba(52,211,153,.13);border:1px solid rgba(52,211,153,.3);color:#6ee7b7;
}
.float-icon.purple{background:rgba(168,85,247,.14);border-color:rgba(168,85,247,.32);color:#d8b4fe;}
.float-icon svg{width:16px;height:16px;}
@keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-11px);}}

/* ═══════════════════════════════════════════════════════════
   7. TOOLBAR (search + filters)
   ═══════════════════════════════════════════════════════════ */
.toolbar{
  display:flex;flex-wrap:wrap;gap:12px;align-items:center;
  margin-bottom:34px;
}
.search-wrap{
  position:relative;flex:1;min-width:220px;
}
.search-wrap svg{
  position:absolute;inset-inline-start:14px;top:50%;transform:translateY(-50%);
  width:17px;height:17px;color:var(--muted-2);pointer-events:none;
}
.search-input{
  width:100%;padding:13px 16px 13px 42px;
  border-radius:var(--radius-sm);
  border:1px solid var(--border);background:var(--surface);
  font-size:14px;color:var(--text);
  transition:.28s var(--ease);
  backdrop-filter:blur(10px);
}
html[dir="rtl"] .search-input{padding:13px 42px 13px 16px;}
.search-input::placeholder{color:var(--muted-2);}
.search-input:focus{
  outline:none;border-color:rgba(139,92,246,.5);
  background:var(--surface-2);
  box-shadow:0 0 0 4px rgba(139,92,246,.1);
}
.filters{display:flex;flex-wrap:wrap;gap:8px;}
.chip{
  padding:10px 16px;border-radius:99px;
  border:1px solid var(--border);background:var(--surface);
  font-size:13.4px;font-weight:600;color:var(--muted);
  transition:.26s var(--ease);backdrop-filter:blur(10px);
  white-space:nowrap;
}
.chip:hover{color:#fff;background:var(--surface-3);border-color:var(--border-2);}
.chip.active{
  color:#fff;
  background:linear-gradient(135deg,rgba(99,102,241,.9),rgba(168,85,247,.85));
  border-color:transparent;
  box-shadow:0 10px 26px -12px rgba(139,92,246,.95);
}
.chip .count{display:inline-block;margin-inline-start:7px;opacity:.62;font-size:11.5px;font-variant-numeric:tabular-nums;}

/* ═══════════════════════════════════════════════════════════
   8. PRODUCT CARDS
   ═══════════════════════════════════════════════════════════ */
.product-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(min(100%, 295px), 1fr));
  gap:20px;
}
.card{
  position:relative;border-radius:var(--radius);
  padding:20px;display:flex;flex-direction:column;
  overflow:hidden;
  transition:transform .4s var(--ease), border-color .4s ease, box-shadow .4s ease;
  background:linear-gradient(165deg, rgba(255,255,255,.062), rgba(255,255,255,.018));
  border:1px solid var(--border);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  box-shadow:var(--shadow-md);
}
.card::after{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:radial-gradient(420px 220px at var(--mx,50%) var(--my,0%), rgba(139,92,246,.17), transparent 70%);
  opacity:0;transition:opacity .45s ease;
}
.card:hover{
  transform:translateY(-6px);
  border-color:rgba(255,255,255,.19);
  box-shadow:0 40px 70px -34px rgba(0,0,0,1), 0 0 0 1px rgba(139,92,246,.2);
}
.card:hover::after{opacity:1;}

.card-thumb{
  height:108px;border-radius:var(--radius-sm);
  display:grid;place-items:center;margin-bottom:16px;
  position:relative;overflow:hidden;
  border:1px solid rgba(255,255,255,.06);
}
.card-thumb svg{width:82%;height:auto;max-height:64px;position:relative;z-index:1;}
.thumb-n8n{background:linear-gradient(140deg,rgba(34,211,238,.14),rgba(99,102,241,.1));color:#67e8f9;}
.thumb-dify{background:linear-gradient(140deg,rgba(168,85,247,.16),rgba(99,102,241,.09));color:#d8b4fe;}
.thumb-code{background:linear-gradient(140deg,rgba(52,211,153,.13),rgba(34,211,238,.08));color:#6ee7b7;}
.card-thumb::before{
  content:"";position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);
  background-size:22px 22px;opacity:.55;
}

.card-top{display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap;}
.tag{
  font-size:10.5px;font-weight:700;letter-spacing:.055em;text-transform:uppercase;
  padding:5px 10px;border-radius:7px;border:1px solid transparent;
}
.tag-n8n{color:#67e8f9;background:rgba(34,211,238,.1);border-color:rgba(34,211,238,.26);}
.tag-dify{color:#d8b4fe;background:rgba(168,85,247,.11);border-color:rgba(168,85,247,.28);}
.tag-code{color:#6ee7b7;background:rgba(52,211,153,.1);border-color:rgba(52,211,153,.26);}

.badge{
  margin-inline-start:auto;
  font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  padding:5px 9px;border-radius:7px;white-space:nowrap;
}
.badge.hot{color:#fca5a5;background:rgba(248,113,113,.13);border:1px solid rgba(248,113,113,.3);}
.badge.new{color:#a5b4fc;background:rgba(99,102,241,.14);border:1px solid rgba(129,140,248,.32);}
.badge.bestseller{color:#fde68a;background:linear-gradient(135deg,rgba(251,191,36,.16),rgba(245,158,11,.1));border:1px solid rgba(251,191,36,.3);}

.card h3{
  font-size:16.5px;font-weight:700;letter-spacing:-0.028em;
  margin-bottom:8px;line-height:1.35;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:2.7em;
}
.card .desc{
  font-size:13.3px;color:var(--muted);line-height:1.62;margin-bottom:14px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:2.7em;
}
.card-meta{
  display:flex;align-items:center;gap:9px;
  font-size:11.8px;color:var(--muted-2);
  margin-bottom:14px;padding-bottom:14px;
  border-bottom:1px solid var(--border);
}
.stars{display:flex;gap:1px;color:#fbbf24;flex:none;}
.stars svg{width:11px;height:11px;}

.card-foot{
  display:flex;align-items:flex-end;justify-content:space-between;gap:10px;
  margin-top:auto;
}
.price{display:flex;flex-direction:column;gap:2px;min-width:0;}
.price-now{font-size:18px;font-weight:800;letter-spacing:-0.038em;white-space:nowrap;}
.price-usd{font-size:11px;color:var(--muted-2);font-weight:500;}
.price-old{font-size:11.5px;color:var(--muted-2);text-decoration:line-through;}

.card-actions{display:flex;gap:6px;flex:none;}
.wish-btn{
  width:34px;height:34px;border-radius:10px;
  display:grid;place-items:center;
  border:1px solid var(--border);background:var(--surface);
  color:var(--muted);transition:.25s var(--ease);
}
.wish-btn:hover{color:#f472b6;border-color:rgba(244,114,182,.4);background:rgba(244,114,182,.08);}
.wish-btn svg{width:15px;height:15px;}
.wish-btn.active{color:#ec4899;background:rgba(236,72,153,.13);border-color:rgba(236,72,153,.45);}
.wish-btn.active svg{fill:currentColor;}

/* Skeleton */
.skeleton-card{
  border-radius:var(--radius);padding:20px;
  background:linear-gradient(165deg, rgba(255,255,255,.05), rgba(255,255,255,.015));
  border:1px solid var(--border);
}
.sk{
  border-radius:8px;
  background:linear-gradient(90deg, rgba(255,255,255,.04) 25%, rgba(255,255,255,.09) 50%, rgba(255,255,255,.04) 75%);
  background-size:200% 100%;
  animation:shimmer 1.6s infinite linear;
}
@keyframes shimmer{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
.sk-thumb{height:108px;border-radius:var(--radius-sm);margin-bottom:16px;}
.sk-line{height:12px;margin-bottom:9px;}
.sk-line.w70{width:70%;}
.sk-line.w90{width:90%;}
.sk-line.w50{width:50%;}

/* Empty state */
.empty-grid{
  grid-column:1/-1;
  text-align:center;padding:70px 20px;color:var(--muted-2);
}
.empty-grid svg{width:54px;height:54px;margin:0 auto 18px;opacity:.35;}
.empty-grid p{font-size:15px;color:var(--muted);margin-bottom:6px;}

/* ═══════════════════════════════════════════════════════════
   9. FEATURES / FAQ
   ═══════════════════════════════════════════════════════════ */
.feat-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));
  gap:18px;
}
.feat{
  padding:26px 22px;border-radius:var(--radius);
  transition:.38s var(--ease);
}
.feat:hover{transform:translateY(-5px);border-color:rgba(255,255,255,.18);}
.feat-icon{
  width:44px;height:44px;border-radius:12px;margin-bottom:16px;
  display:grid;place-items:center;
  background:linear-gradient(135deg,rgba(99,102,241,.18),rgba(168,85,247,.13));
  border:1px solid rgba(139,92,246,.28);color:#c4b5fd;
}
.feat-icon svg{width:21px;height:21px;}
.feat h4{font-size:16px;margin-bottom:8px;letter-spacing:-0.025em;}
.feat p{font-size:13.5px;color:var(--muted);line-height:1.68;}

.faq-wrap{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:11px;}
.faq-item{border-radius:var(--radius-sm);overflow:hidden;transition:.3s var(--ease);}
.faq-item.open{border-color:rgba(139,92,246,.32);background:linear-gradient(160deg,rgba(139,92,246,.075),rgba(255,255,255,.02));}
.faq-q{
  width:100%;display:flex;align-items:center;gap:16px;
  padding:18px 20px;text-align:start;
  font-size:15px;font-weight:600;letter-spacing:-0.02em;
  color:var(--text);transition:.24s;
}
.faq-q:hover{color:#fff;}
.faq-icon{
  margin-inline-start:auto;flex:none;
  width:26px;height:26px;border-radius:8px;
  display:grid;place-items:center;
  border:1px solid var(--border-2);color:var(--muted);
  transition:.34s var(--ease);
}
.faq-icon svg{width:13px;height:13px;transition:.34s var(--ease);}
.faq-item.open .faq-icon{
  background:var(--grad-btn);border-color:transparent;color:#fff;
  transform:rotate(180deg);
}
.faq-a{max-height:0;overflow:hidden;transition:max-height .45s var(--ease);}
.faq-a-inner{padding:0 20px 20px;font-size:14px;color:var(--muted);line-height:1.78;}

/* ═══════════════════════════════════════════════════════════
   10. FOOTER
   ═══════════════════════════════════════════════════════════ */
.footer{
  border-top:1px solid var(--border);
  padding:60px 0 32px;margin-top:80px;
  background:linear-gradient(180deg,transparent,rgba(99,102,241,.035));
}
.footer-grid{
  display:grid;
  grid-template-columns:minmax(0,1.6fr) repeat(auto-fit,minmax(130px,1fr));
  gap:38px 28px;margin-bottom:48px;
}
.footer-brand p{font-size:13.6px;color:var(--muted);line-height:1.72;margin:16px 0 22px;max-width:330px;}
.socials{display:flex;gap:9px;}
.footer h5{
  font-size:12.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;
  color:var(--muted-2);margin:0 0 15px;
}
.footer-col a{
  display:block;font-size:13.7px;color:var(--muted);padding:6px 0;transition:.22s;
}
.footer-col a:hover{color:#fff;transform:translateX(3px);}
.footer-bottom{
  display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;
  padding-top:26px;border-top:1px solid var(--border);
  font-size:12.6px;color:var(--muted-2);
}
.pay-badges{display:flex;gap:8px;flex-wrap:wrap;}
.pay-badge{
  padding:5px 11px;border-radius:8px;
  border:1px solid var(--border);background:var(--surface);
  font-size:11.5px;font-weight:600;color:var(--muted);
}

/* ═══════════════════════════════════════════════════════════
   11. OVERLAY / DRAWER / MODAL
   ═══════════════════════════════════════════════════════════ */
.overlay{
  position:fixed;inset:0;z-index:90;
  background:rgba(3,4,9,.72);
  backdrop-filter:blur(9px);-webkit-backdrop-filter:blur(9px);
  opacity:0;pointer-events:none;transition:opacity .35s ease;
}
.overlay.show{opacity:1;pointer-events:auto;}

.drawer{
  position:fixed;top:0;inset-inline-end:0;bottom:0;z-index:95;
  width:min(420px,100%);
  display:flex;flex-direction:column;
  background:linear-gradient(170deg,rgba(14,16,26,.97),rgba(7,8,14,.99));
  border-inline-start:1px solid var(--border-2);
  box-shadow:-40px 0 90px -40px rgba(0,0,0,1);
  transform:translateX(102%);
  transition:transform .46s var(--ease);
  will-change:transform;
}
html[dir="rtl"] .drawer{transform:translateX(-102%);box-shadow:40px 0 90px -40px rgba(0,0,0,1);}
.drawer.open{transform:none;}
.drawer-head{
  display:flex;align-items:center;gap:12px;
  padding:20px 22px;border-bottom:1px solid var(--border);flex:none;
}
.drawer-head h3{font-size:17px;letter-spacing:-0.03em;}
.count-pill{
  font-size:12px;font-weight:700;color:#c4b5fd;
  padding:3px 9px;border-radius:99px;
  background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.28);
  white-space:nowrap;
}
.drawer-head .icon-btn{margin-inline-start:auto;}
.drawer-body{
  flex:1;overflow-y:auto;padding:18px 22px;
  display:flex;flex-direction:column;gap:13px;
}
.drawer-foot{
  flex:none;padding:20px 22px calc(20px + env(safe-area-inset-bottom));
  border-top:1px solid var(--border);background:rgba(255,255,255,.017);
}
.row{
  display:flex;align-items:center;justify-content:space-between;
  font-size:13.8px;color:var(--muted);margin-bottom:9px;gap:12px;
}
.row strong{color:var(--text);font-weight:600;}
.row.total{
  font-size:16px;color:var(--text);font-weight:700;
  padding-top:13px;margin-top:5px;margin-bottom:17px;
  border-top:1px dashed var(--border-2);
}
.row.total strong{
  font-size:21px;letter-spacing:-0.04em;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;
}
.green{color:#6ee7b7!important;}
.tiny{font-size:11.6px;color:var(--muted-2);text-align:center;margin-top:12px;line-height:1.6;}

.cart-item{
  display:flex;gap:13px;align-items:flex-start;
  padding:13px;border-radius:var(--radius-sm);
  border:1px solid var(--border);background:rgba(255,255,255,.026);
  animation:fadeUp .35s var(--ease);
}
.cart-item-thumb{
  width:46px;height:46px;border-radius:11px;flex:none;
  display:grid;place-items:center;
  font-size:11px;font-weight:800;color:#fff;letter-spacing:-0.02em;
}
.ci-n8n{background:linear-gradient(135deg,#0e7490,#22d3ee);}
.ci-dify{background:linear-gradient(135deg,#7c3aed,#c084fc);}
.ci-code{background:linear-gradient(135deg,#047857,#34d399);}
.cart-item-info{flex:1;min-width:0;}
.cart-item-info h4{
  font-size:13.4px;font-weight:600;line-height:1.4;margin-bottom:4px;
  letter-spacing:-0.02em;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.cart-item-info .ci-price{font-size:13px;font-weight:700;color:#c4b5fd;}
.qty-ctrl{
  display:flex;align-items:center;gap:2px;margin-top:9px;
  border:1px solid var(--border);border-radius:9px;
  width:fit-content;overflow:hidden;
}
.qty-ctrl button{
  width:26px;height:26px;display:grid;place-items:center;
  color:var(--muted);font-size:15px;font-weight:600;transition:.2s;
}
.qty-ctrl button:hover{background:var(--surface-3);color:#fff;}
.qty-ctrl span{
  min-width:26px;text-align:center;font-size:12.6px;font-weight:700;
  font-variant-numeric:tabular-nums;
}
.ci-remove{
  color:var(--muted-2);padding:4px;border-radius:7px;transition:.2s;flex:none;
}
.ci-remove:hover{color:#f87171;background:rgba(248,113,113,.1);}
.ci-remove svg{width:15px;height:15px;}

.empty-state{text-align:center;padding:50px 20px;color:var(--muted-2);}
.empty-state svg{width:50px;height:50px;margin:0 auto 16px;opacity:.35;}
.empty-state p{font-size:14px;margin-bottom:6px;color:var(--muted);}
.empty-state small{font-size:12.3px;}

/* ═══════════════════════════════════════════════════════════
   12. PAYMENT MODAL
   ═══════════════════════════════════════════════════════════ */
.modal-shell{
  position:fixed;inset:0;z-index:100;
  display:flex;align-items:center;justify-content:center;
  padding:20px;opacity:0;pointer-events:none;
  transition:opacity .32s ease;
}
.modal-shell.show{opacity:1;pointer-events:auto;}
.modal{
  position:relative;width:min(560px,100%);
  max-height:min(90vh,860px);overflow-y:auto;
  border-radius:24px;
  background:linear-gradient(168deg,rgba(16,18,29,.985),rgba(7,8,14,.995));
  border:1px solid var(--border-2);
  box-shadow:0 60px 120px -40px rgba(0,0,0,1), 0 0 0 1px rgba(139,92,246,.14);
  transform:scale(.94) translateY(14px);
  transition:transform .42s var(--ease);
  scrollbar-width:thin;
}
.modal-shell.show .modal{transform:none;}
.modal::before{
  content:"";position:absolute;top:0;left:10%;right:10%;height:1px;
  background:linear-gradient(90deg,transparent,rgba(196,181,253,.85),transparent);
}
.modal-head{
  display:flex;align-items:flex-start;gap:14px;
  padding:24px 26px 20px;border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:2;
  background:linear-gradient(180deg,rgba(16,18,29,.99),rgba(16,18,29,.92));
  backdrop-filter:blur(14px);
  border-radius:24px 24px 0 0;
}
.modal-head h3{font-size:18px;letter-spacing:-0.032em;margin-bottom:5px;}
.modal-head p{font-size:12.8px;color:var(--muted);}
.modal-head .icon-btn{margin-inline-start:auto;flex:none;}
.modal-body{padding:22px 26px 26px;}

.order-summary{
  border-radius:var(--radius-sm);
  border:1px solid var(--border);background:rgba(255,255,255,.026);
  padding:15px 17px;margin-bottom:20px;
}
.os-line{
  display:flex;justify-content:space-between;gap:14px;
  font-size:13px;color:var(--muted);padding:5px 0;
}
.os-line span:first-child{
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:64%;
}
.os-line span:last-child{flex:none;color:var(--text-2);font-weight:600;font-variant-numeric:tabular-nums;}
.os-total{
  display:flex;justify-content:space-between;align-items:baseline;gap:14px;
  margin-top:11px;padding-top:13px;border-top:1px dashed var(--border-2);
}
.os-total span{font-size:13.4px;color:var(--text-2);font-weight:600;}
.os-total strong{
  font-size:21px;font-weight:800;letter-spacing:-0.042em;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;
}

.pay-tabs{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:22px;}
.pay-tab{
  display:flex;align-items:center;justify-content:center;gap:9px;
  padding:13px 12px;border-radius:var(--radius-sm);
  border:1px solid var(--border);background:rgba(255,255,255,.026);
  font-size:13.5px;font-weight:600;color:var(--muted);
  transition:.28s var(--ease);
}
.pay-tab:hover{color:#fff;border-color:var(--border-2);}
.pay-tab.active{
  color:#fff;border-color:rgba(139,92,246,.5);
  background:linear-gradient(150deg,rgba(99,102,241,.19),rgba(168,85,247,.11));
  box-shadow:0 12px 32px -16px rgba(124,58,237,.95), inset 0 1px 0 rgba(255,255,255,.1);
}
.pay-tab svg{width:18px;height:18px;flex:none;}
.pay-tab small{display:block;font-size:10.5px;font-weight:500;color:var(--muted-2);letter-spacing:0;margin-top:2px;text-align:start;}
.pay-tab .pt-text{text-align:start;line-height:1.25;}

.pay-panel{display:none;}
.pay-panel.active{display:block;animation:fadeUp .4s var(--ease);}

.qr-block{
  display:flex;gap:20px;align-items:center;
  padding:18px;border-radius:var(--radius-sm);
  border:1px solid var(--border);background:rgba(255,255,255,.026);
  margin-bottom:18px;
}
.qr-frame{
  width:132px;height:132px;flex:none;border-radius:14px;padding:9px;
  background:#fff;
  box-shadow:0 12px 34px -14px rgba(0,0,0,.9), 0 0 0 1px rgba(255,255,255,.1);
}
.qr-frame canvas{width:100%;height:100%;display:block;border-radius:6px;}
.qr-info{flex:1;min-width:0;}
.qr-info h4{font-size:14.3px;margin-bottom:6px;letter-spacing:-0.025em;}
.qr-info p{font-size:12.4px;color:var(--muted);line-height:1.62;}
.qr-pulse{
  display:inline-flex;align-items:center;gap:6px;margin-top:10px;
  font-size:11.4px;font-weight:600;color:#6ee7b7;
}
.qr-pulse i{
  width:6px;height:6px;border-radius:50%;background:#34d399;
  box-shadow:0 0 9px 2px rgba(52,211,153,.85);
  animation:pulse 1.8s ease-in-out infinite;flex:none;
}

.kv-list{display:flex;flex-direction:column;gap:8px;margin-bottom:16px;}
.kv{
  display:flex;align-items:center;gap:12px;
  padding:11px 14px;border-radius:var(--radius-xs);
  border:1px solid var(--border);background:rgba(255,255,255,.022);
}
.kv-label{
