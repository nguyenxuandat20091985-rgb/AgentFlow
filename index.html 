/* ─────────────── 5. AI CHAT — PRIMARY + FALLBACK ─────────────── */
/* The knowledge base lives entirely in code. Answers are not rendered
   until the user sends a message. Language is detected from input. */

/* Detect language from a message */
function detectLanguage(msg) {
  if (!msg) return currentLang;
  if (/[\u4e00-\u9fff]/.test(msg)) return 'zh';
  if (/[\u3040-\u30ff]/.test(msg)) return 'ja';
  if (/[\uac00-\ud7af]/.test(msg)) return 'ko';
  if (/[\u0600-\u06ff]/.test(msg)) return 'ar';
  if (/[\u0400-\u04ff]/.test(msg)) return 'ru';
  // Vietnamese diacritics
  if (/[àáảãạăằắẳẵặâầấẩẫậèéẻẽẹêềếểễệìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵđ]/i.test(msg)) return 'vi';
  // Heuristic by common words
  const lower = ' ' + msg.toLowerCase() + ' ';
  if (/\b(hola|gracias|cómo|qué|precio|comprar)\b/.test(lower)) return 'es';
  if (/\b(bonjour|merci|comment|prix|acheter)\b/.test(lower)) return 'fr';
  if (/\b(hallo|danke|wie|preis|kaufen)\b/.test(lower)) return 'de';
  if (/\b(привет|спасибо|как|цена|купить)\b/.test(lower)) return 'ru';
  if (/\b(xin chào|cảm ơn|giá|mua|sản phẩm)\b/.test(lower)) return 'vi';
  if (/\b(hello|hi|thanks|price|buy|product)\b/.test(lower)) return 'en';
  return currentLang;
}

