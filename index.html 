/* ─────────────── 14. SCROLL REVEAL ─────────────── */
let revealObs = null;
function observeReveals() {
  if (!('IntersectionObserver' in window)) {
    $$('.reveal').forEach(el => el.classList.add('in'));
    return;
  }
  if (!revealObs) {
    revealObs = new IntersectionObserver((entries) => {
      entries.forEach(en => {
        if (en.isIntersecting) {
          en.target.classList.add('in');
          revealObs.unobserve(en.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
  }
  $$('.reveal:not(.in)').forEach(el => revealObs.observe(el));
}

/* ─────────────── 15. AI CHAT UI ─────────────── */
let chatOpen = false;
let chatMessages = []; // { role, text }

function renderSuggestions() {
  const wrap = $('#chatSuggestions');
  if (!wrap) return;
  wrap.innerHTML = `
    <button class="suggest-chip" data-suggest="bestseller">${t('chat_suggest1')}</button>
    <button class="suggest-chip" data-suggest="payment_usdt">${t('chat_suggest2')}</button>
    <button class="suggest-chip" data-suggest="leadgen">${t('chat_suggest3')}</button>
  `;
}

function updateChatWelcome() {
  /* If chat has no messages, seed with welcome message */
  if (chatMessages.length === 0) {
    chatMessages = [{ role: 'bot', text: t('chat_welcome') }];
    renderChatMessages();
  } else if (chatMessages.length === 1 && chatMessages[0].role === 'bot') {
    chatMessages[0].text = t('chat_welcome');
    renderChatMessages();
  }
}

function renderChatMessages() {
  const body = $('#chatBody');
  body.innerHTML = chatMessages.map(m => {
    if (m.role === 'bot') {
      return `
        <div class="chat-msg bot">
          <div class="msg-avatar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>
            </svg>
          </div>
          <div class="msg-bubble">${formatBotText(m.text)}</div>
        </div>`;
    }
    return `
      <div class="chat-msg user">
        <div class="msg-bubble">${escapeHtml(m.text)}</div>
      </div>`;
  }).join('');
  body.scrollTop = body.scrollHeight;
}

/* Very light markdown for bot replies: **bold**, newlines, bullets */
function formatBotText(text) {
  return escapeHtml(text)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\n/g, '<br>');
}

function appendTyping() {
  const body = $('#chatBody');
  const el = document.createElement('div');
  el.className = 'chat-msg bot';
  el.id = 'typingIndicator';
  el.innerHTML = `
    <div class="msg-avatar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>
      </svg>
    </div>
    <div class="msg-bubble typing"><i></i><i></i><i></i></div>
  `;
  body.appendChild(el);
  body.scrollTop = body.scrollHeight;
}

function removeTyping() {
  const el = $('#typingIndicator');
  if (el) el.remove();
}

function openChat() {
  chatOpen = true;
  $('#chatPanel').classList.add('open');
  setTimeout(() => $('#chatInput').focus(), 300);
}

function closeChat() {
  chatOpen = false;
  $('#chatPanel').classList.remove('open');
}

async function sendChat(text) {
  text = (text || '').trim();
  if (!text) return;

  chatMessages.push({ role: 'user', text });
  renderChatMessages();
  $('#chatInput').value = '';
  $('#chatSend').disabled = true;

  appendTyping();

  let reply;
  try {
    const res = await aiRespond(text);
    reply = res.reply;
    console.log('[AI] source:', res.source, 'lang:', res.lang);
  } catch (e) {
    console.error('[AI] fatal:', e);
    reply = CHAT_FALLBACK[currentLang] || CHAT_FALLBACK.en;
  }

  removeTyping();
  chatMessages.push({ role: 'bot', text: reply });
  renderChatMessages();
}

/* ─────────────── 16. GLOBAL EVENT BINDINGS ─────────────── */
function bindEvents() {
  /* Delegated clicks */
  document.addEventListener('click', (e) => {
    const addBtn = e.target.closest('[data-add]');
    if (addBtn) { addToCart(addBtn.dataset.add); return; }

    const wishBtn = e.target.closest('[data-wish]');
    if (wishBtn) { toggleWishlist(wishBtn.dataset.wish); return; }

    const qtyBtn = e.target.closest('[data-qty]');
    if (qtyBtn) {
      const id = qtyBtn.dataset.qty;
      const delta = parseInt(qtyBtn.dataset.delta, 10);
      setQty(id, (cart[id] || 0) + delta);
      return;
    }

    const rmBtn = e.target.closest('[data-remove]');
    if (rmBtn) {
      removeFromCart(rmBtn.dataset.remove);
      toast(t('cart_removed'), 'info', 1600);
      return;
    }

    const confirmBtn = e.target.closest('[data-confirm]');
    if (confirmBtn) {
      showPaymentSuccess(confirmBtn.dataset.confirm);
      return;
    }

    const sugg = e.target.closest('[data-suggest]');
    if (sugg) {
      const intent = sugg.dataset.suggest;
      const lang = currentLang;
      const text = (CHAT_BANK[intent] && CHAT_BANK[intent][lang]) || CHAT_BANK[intent].en;
      /* Push a user-like message and let AI reply */
      const fakeQ = sugg.textContent;
      sendChat(fakeQ);
      return;
    }
  });

  /* Filters */
  $('#filters').addEventListener('click', (e) => {
    const chip = e.target.closest('.chip');
    if (!chip) return;
    $$('#filters .chip').forEach(c => c.classList.toggle('active', c === chip));
    currentFilter = chip.dataset.filter;
    renderProducts();
  });

  /* Search */
  $('#searchInput').addEventListener('input', debounce((e) => {
    currentSearch = e.target.value;
    renderProducts();
  }, 200));

  /* Cart */
  $('#cartBtn').addEventListener('click', openCart);
  $('#closeCart').addEventListener('click', closeCart);
  $('#checkoutBtn').addEventListener('click', openPay);

  /* Overlay click */
  overlay.addEventListener('click', () => {
    if (payModal.classList.contains('show')) closePay();
    else closeCart();
  });

  /* Payment modal */
  $('#closePay').addEventListener('click', closePay);
  $('#successDone').addEventListener('click', () => {
    cart = {};
    saveState();
    renderCart();
    updateCartBadge();
    closePay();
    toast('✓', 'success', 1200);
  });

  /* Payment tabs */
  $('#payTabs').addEventListener('click', (e) => {
    const tab = e.target.closest('.pay-tab');
    if (!tab) return;
    const method = tab.dataset.method;
    $$('#payTabs .pay-tab').forEach(x => x.classList.toggle('active', x === tab));
    $('#panel-payos').classList.toggle('active', method === 'payos');
    $('#panel-usdt').classList.toggle('active', method === 'usdt');

    requestAnimationFrame(() => {
      if (method === 'payos') drawQR($('#qrPayos'), payosSeed());
      else setCryptoQR();
    });
  });

  /* Network chips */
  $('#netChips').addEventListener('click', (e) => {
    const chip = e.target.closest('.net-chip');
    if (!chip) return;
    setNetwork(chip.dataset.net);
    toast(`${t('chat_net_changed')}: ${chip.dataset.net}`, 'info', 1600);
  });

  /* Language menu */
  $('#langBtn').addEventListener('click', (e) => {
    e.stopPropagation();
    $('#langMenu').classList.toggle('open');
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('#langMenu') && !e.target.closest('#langBtn')) {
      $('#langMenu').classList.remove('open');
    }
  });

  /* Hamburger */
  $('#hamburger').addEventListener('click', () => {
    $('#mobileMenu').classList.toggle('open');
  });
  $$('#mobileMenu a').forEach(a => {
    a.addEventListener('click', () => $('#mobileMenu').classList.remove('open'));
  });

  /* Wishlist button (opens first wishlist item or scrolls to products) */
  $('#wishlistBtn').addEventListener('click', () => {
    if (wishlist.size === 0) {
      toast(currentLang === 'vi' ? 'Chưa có sản phẩm yêu thích' : 'No items in wishlist', 'info', 1800);
      return;
    }
    document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
  });

  /* Chat */
  $('#chatFab').addEventListener('click', () => {
    if (chatOpen) closeChat(); else openChat();
  });
  $('#heroChatBtn').addEventListener('click', openChat);
  $('#closeChat').addEventListener('click', closeChat);

  $('#chatSend').addEventListener('click', () => {
    sendChat($('#chatInput').value);
  });

  $('#chatInput').addEventListener('input', (e) => {
    $('#chatSend').disabled = e.target.value.trim().length === 0;
    /* auto-grow */
    e.target.style.height = 'auto';
    e.target.style.height = Math.min(e.target.scrollHeight, 100) + 'px';
  });

  $('#chatInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      if (!$('#chatSend').disabled) sendChat($('#chatInput').value);
    }
  });

  /* Escape */
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (payModal.classList.contains('show')) closePay();
    else if (cartDrawer.classList.contains('open')) closeCart();
    else if (chatOpen) closeChat();
    else $('#mobileMenu').classList.remove('open');
  });

  /* Nav scroll */
  const nav = $('#nav');
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 12);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* Resize QR */
  let rt;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(() => {
      if (payModal.classList.contains('show')) {
        drawQR($('#qrPayos'), payosSeed());
        setCryptoQR();
      }
    }, 220);
  });
}

/* ─────────────── 17. INIT ─────────────── */
function init() {
  /* 1. Load persisted state */
  loadState();

  /* 2. Determine language */
  const initialLang = detectBrowserLanguage();

  /* 3. Build language menu (before applying, so active state works) */
  buildLangMenu();

  /* 4. Seed chat welcome */
  chatMessages = [{ role: 'bot', text: t(initialLang === 'en' ? 'en' : initialLang) === undefined ? '' : (T[initialLang]?.chat_welcome || T.en.chat_welcome) }];

  /* 5. Show skeletons while "loading" */
  renderSkeletons(8);

  /* 6. Apply language (renders products, cart, suggestions) */
  applyLanguage(initialLang);

  /* 7. Bind events */
  bindEvents();
  bindCopyButtons();
  initFAQ();
  observeReveals();

  /* 8. Set initial network */
  setNetwork('TRC20');

  /* 9. Reveal hero code with syntax highlight */
  const hero = $('#heroCode');
  if (hero) {
    const raw = hero.textContent;
    hero.innerHTML = highlightCode(raw);
  }

  /* 10. Initial chat render */
  updateChatWelcome();
  renderChatMessages();

  /* 11. Simulate load complete after 700ms */
  setTimeout(() => {
    renderProducts();
    renderFilterCounts();
    observeReveals();
  }, 700);
}

/* Minimal syntax highlighter for hero code */
function highlightCode(code) {
  const escaped = escapeHtml(code);
  const re = /("(?:[^"\\]|\\.)*")|(\/\/[^\n]*)|(\b(?:true|false|null)\b)|(\b\d+(?:\.\d+)?\b)/g;
  return escaped.replace(re, (m, str, com, kw, num) => {
    if (str) return '<span class="tk-str">' + str + '</span>';
    if (com) return '<span class="tk-com">' + com + '</span>';
    if (kw) return '<span class="tk-kw">' + kw + '</span>';
    if (num) return '<span class="tk-num">' + num + '</span>';
    return m;
  });
}

/* Fire! */
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
