  .stat{min-width:calc(50% - 12px);}
  pre.code{font-size:11.2px;padding:15px 14px 17px;}
  .float-card{padding:10px 12px;font-size:12px;}
  .float-1{top:-14px;}
  .float-2{bottom:-14px;}
  .modal-shell{padding:0;align-items:flex-end;}
  .modal{max-height:94vh;border-radius:24px 24px 0 0;width:100%;}
  .modal-head{border-radius:24px 24px 0 0;padding:20px 20px 17px;}
  .modal-body{padding:20px 20px calc(24px + env(safe-area-inset-bottom));}
  .qr-block{flex-direction:column;text-align:center;gap:16px;}
  .qr-info{text-align:center;}
  .kv-label{width:70px;font-size:10px;}
  .kv-value{font-size:11.4px;}
  .toast-wrap{inset-inline-end:16px;inset-inline-start:16px;bottom:86px;max-width:none;}
  .toast{max-width:none;}
  .drawer{width:100%;}
  .chat-panel{
    bottom:0;inset-inline-end:0;left:0;right:0;
    width:100%;height:100%;height:100dvh;
    border-radius:0;border:0;
  }
  .chat-fab{bottom:18px;inset-inline-end:18px;width:54px;height:54px;}
  .chat-fab svg{width:23px;height:23px;}
}
@media (max-width:520px){
  .card-foot{flex-direction:column;align-items:stretch;gap:12px;}
  .card-foot .btn{width:100%;}
